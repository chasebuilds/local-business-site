{% macro icon(name) -%}
<svg class="icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
{%- if name == "phone" %}<path d="M6.6 10.8a15.1 15.1 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11.4 11.4 0 0 0 3.6.57 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.25.2 2.45.57 3.57a1 1 0 0 1-.25 1z"/>
{%- elif name == "pin" %}<path d="M12 2a7 7 0 0 0-7 7c0 5.25 7 13 7 13s7-7.75 7-13a7 7 0 0 0-7-7zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5z"/>
{%- elif name == "clock" %}<path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm1 10.4 3.2 1.9-.8 1.3L11 13V7h2z"/>
{%- elif name == "mail" %}<path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2zm8 7.2L20 6H4zm0 2.3L4 8.3V18h16V8.3z"/>
{%- elif name == "facebook" %}<path d="M14 8V6.1c0-.9.2-1.4 1.6-1.4H17V1.2A23 23 0 0 0 14.6 1C12.2 1 10.6 2.5 10.6 5.1V8H8v3.6h2.6V23H14V11.6h2.8l.4-3.6z"/>
{%- elif name == "google" %}<path d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.9h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.4zM12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22zM6.4 14a6 6 0 0 1 0-3.9V7.5H3.1a10 10 0 0 0 0 9zM12 5.9c1.5 0 2.8.5 3.8 1.5l2.9-2.9A10 10 0 0 0 3.1 7.5l3.3 2.6C7.2 7.7 9.4 5.9 12 5.9z"/>
{%- elif name == "instagram" %}<path fill-rule="evenodd" d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zM17.3 5.5a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4zM12 2c-2.7 0-3 0-4.1.1C4 2.3 2.3 4 2.1 7.9 2 9 2 9.3 2 12s0 3 .1 4.1c.2 3.9 1.9 5.6 5.8 5.8 1.1.1 1.4.1 4.1.1s3 0 4.1-.1c3.9-.2 5.6-1.9 5.8-5.8.1-1.1.1-1.4.1-4.1s0-3-.1-4.1C21.7 4 20 2.3 16.1 2.1 15 2 14.7 2 12 2z"/>
{%- else %}<path d="M10.6 13.4a1 1 0 0 1 0-1.4l3.5-3.5a3 3 0 1 1 4.2 4.2l-1.8 1.8-1.4-1.4 1.8-1.8a1 1 0 1 0-1.4-1.4L12 13.4a1 1 0 0 1-1.4 0zM13.4 10.6a1 1 0 0 1 0 1.4l-3.5 3.5a3 3 0 1 1-4.2-4.2l1.8-1.8 1.4 1.4-1.8 1.8a1 1 0 1 0 1.4 1.4L12 10.6a1 1 0 0 1 1.4 0z"/>
{%- endif %}</svg>
{%- endmacro %}
<!doctype html>
<html lang="en" class="theme-{{ theme }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site.name }} | {{ site.type|capitalize }} in {{ site.town }}</title>
<meta name="description" content="{{ description }}">
<meta name="theme-color" content="{{ colors.brand }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ site.name }}">
<meta property="og:description" content="{{ description }}">
{% if site.url %}
<meta property="og:url" content="{{ site.url }}">
<link rel="canonical" href="{{ site.url }}">
{% endif %}
{% if photos and photos[0].src.startswith("http") %}
<meta property="og:image" content="{{ photos[0].src }}">
{% endif %}
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Crect width='64' height='64' rx='16' fill='{{ colors.button|urlencode }}'/%3E%3Ctext x='32' y='43' font-size='32' text-anchor='middle' font-family='Arial' font-weight='700' fill='{{ colors.on_button|urlencode }}'%3E{{ site.name[:1]|urlencode }}%3C/text%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?{{ fonts }}&display=swap">
<style>
:root{--brand:{{ colors.brand }};--btn:{{ colors.button }};--on-btn:{{ colors.on_button }};--ink-light:{{ colors.ink_light }};--ink-dark:{{ colors.ink_dark }};--tint:{{ colors.tint }};--tint-dark:{{ colors.tint_dark }}}
{{ css|safe }}
</style>
<script type="application/ld+json">
{{ json_ld|safe }}
</script>
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<div class="backdrop" aria-hidden="true"></div>
<header class="topbar">
  <div class="bar panel">
    <a class="logo" href="#top"><span class="mark" aria-hidden="true">{{ site.name[:1] }}</span><span>{{ site.name }}</span></a>
    <nav aria-label="Sections">
      {% if site.services %}<a href="#services">Services</a>{% endif %}
      <a href="#hours">Hours</a>
      <a href="#visit">Visit</a>
    </nav>
    <a class="btn btn-sm primary" href="{{ site.phone_href }}">{{ icon("phone") }}<span>Call</span></a>
  </div>
</header>

<main id="main">
  <section class="hero" id="top">
    <div class="hero-text">
      <p class="eyebrow reveal" style="--d:0">{{ site.type|capitalize }} &middot; {{ site.town }}</p>
      <h1 class="reveal" style="--d:1">{{ site.name }}</h1>
      {% if site.tagline %}<p class="tagline reveal" style="--d:2">{{ site.tagline }}</p>{% endif %}
      <div class="actions reveal" style="--d:3">
        <a class="btn primary" href="{{ site.phone_href }}">{{ icon("phone") }}<span>Call {{ site.phone }}</span></a>
        <a class="btn ghost" href="{{ directions }}" target="_blank" rel="noopener">{{ icon("pin") }}<span>Get directions</span></a>
      </div>
      <p class="status reveal" style="--d:4" data-status hidden><span class="dot"></span><span data-status-text></span></p>
    </div>
    <aside class="hero-card panel reveal" style="--d:2" aria-label="At a glance">
      {% if photos %}
      <img class="hero-photo" src="{{ photos[0].src }}" alt="{{ photos[0].alt }}" width="640" height="420" fetchpriority="high">
      {% endif %}
      <dl class="facts">
        <div><dt>{{ icon("clock") }}Today</dt><dd data-today>See hours below</dd></div>
        <div><dt>{{ icon("pin") }}Address</dt><dd>{{ site.full_address }}</dd></div>
        <div><dt>{{ icon("phone") }}Phone</dt><dd><a href="{{ site.phone_href }}">{{ site.phone }}</a></dd></div>
      </dl>
    </aside>
  </section>

  {% if site.services %}
  <section class="section" id="services" aria-labelledby="services-title">
    <div class="section-head">
      <p class="eyebrow">What we do</p>
      <h2 id="services-title">Services</h2>
    </div>
    <ul class="services">
      {% for s in site.services %}
      <li class="service panel reveal" style="--d:{{ loop.index0 % 6 }}">
        <div class="service-top">
          <h3>{{ s.name }}</h3>
          {% if s.price %}<span class="price">{{ s.price }}</span>{% endif %}
        </div>
        {% if s.description %}<p>{{ s.description }}</p>{% endif %}
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if photos|length > 1 %}
  <section class="section" id="gallery" aria-label="Photos">
    <div class="gallery">
      {% for p in photos[1:] %}
      <figure class="reveal" style="--d:{{ loop.index0 }}"><img src="{{ p.src }}" alt="{{ p.alt }}" loading="lazy" width="600" height="450"></figure>
      {% endfor %}
    </div>
  </section>
  {% endif %}

  <section class="section split" aria-label="Hours and location">
    <div class="panel hours-panel" id="hours">
      <h2>{{ icon("clock") }}Hours</h2>
      <table class="hours">
        <caption class="sr-only">Opening hours by day</caption>
        <tbody>
          {% for d in week %}
          <tr data-day="{{ loop.index0 }}"{% if d.label == "Closed" %} class="closed"{% endif %}>
            <th scope="row">{{ d.name }}</th>
            <td>{{ d.label }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    <div class="panel visit-panel" id="visit">
      <h2>{{ icon("pin") }}Visit</h2>
      <address>{{ site.address.street }}<br>{{ site.town }}{% if site.address.region %}, {{ site.address.region }}{% endif %} {{ site.address.postal_code }}</address>
      {% if site.map %}
      <iframe class="map" title="Map showing {{ site.name }}" src="{{ map_embed }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      {% else %}
      <a class="map map-card" href="{{ directions }}" target="_blank" rel="noopener">
        <span class="map-grid" aria-hidden="true"></span>
        <span class="map-pin" aria-hidden="true">{{ icon("pin") }}</span>
        <span class="map-label">Open in Google Maps</span>
      </a>
      {% endif %}
      <a class="btn ghost wide" href="{{ directions }}" target="_blank" rel="noopener">{{ icon("pin") }}<span>Get directions</span></a>
    </div>
  </section>

  <section class="section" id="contact" aria-labelledby="contact-title">
    <div class="panel contact">
      <div>
        <p class="eyebrow">Get in touch</p>
        <h2 id="contact-title">Call, write or stop by</h2>
        <p class="muted">{{ site.full_address }}</p>
      </div>
      <div class="contact-links">
        <a class="btn primary" href="{{ site.phone_href }}">{{ icon("phone") }}<span>{{ site.phone }}</span></a>
        {% if site.email %}<a class="btn ghost" href="mailto:{{ site.email }}">{{ icon("mail") }}<span>{{ site.email }}</span></a>{% endif %}
        {% for name, url in site.links.items() %}
        <a class="btn ghost" href="{{ url }}" target="_blank" rel="noopener">{{ icon(name) }}<span>{{ name|capitalize }}</span></a>
        {% endfor %}
      </div>
    </div>
  </section>
</main>

<footer class="footer">
  <p><strong>{{ site.name }}</strong> &middot; {{ site.full_address }} &middot; <a href="{{ site.phone_href }}">{{ site.phone }}</a></p>
  <p class="muted">&copy; {{ year }} {{ site.name }}{% if site.credit %} &middot; Site by Chase Builds{% endif %}</p>
</footer>

<script type="application/json" id="hours-data">{{ hours_json|safe }}</script>
<script>
(function(){
var H=JSON.parse(document.getElementById("hours-data").textContent),N=["Mon","Tue","Wed","Thu","Fri","Sat","Sun"];
function f(m){m%=1440;var h=Math.floor(m/60),n=m%60,s=h<12?"AM":"PM";h=h%12||12;return h+(n?":"+(n<10?"0":"")+n:"")+" "+s}
var d=new Date(),wd=(d.getDay()+6)%7,m=d.getHours()*60+d.getMinutes();
if(H.tz){try{var p={};new Intl.DateTimeFormat("en-US",{timeZone:H.tz,weekday:"short",hour:"numeric",minute:"numeric",hourCycle:"h23"}).formatToParts(d).forEach(function(x){p[x.type]=x.value});wd=N.indexOf(p.weekday);m=(+p.hour%24)*60+(+p.minute)}catch(e){}}
var row=document.querySelector('tr[data-day="'+wd+'"]');if(row){row.classList.add("today");row.setAttribute("aria-current","date")}
var t="",open=false,i,s,y=H.days[(wd+6)%7];
for(i=0;i<H.days[wd].length;i++){s=H.days[wd][i];if(s[0]<=m&&m<s[1]){open=true;t="Open now, closes "+f(s[1])}}
for(i=0;!open&&i<y.length;i++){s=y[i];if(s[1]>1440&&m+1440<s[1]){open=true;t="Open now, closes "+f(s[1])}}
for(var o=0;!open&&!t&&o<8;o++){var k=(wd+o)%7;for(i=0;i<H.days[k].length;i++){s=H.days[k][i];if(o===0&&s[0]<=m)continue;t="Closed, opens "+(o===0?"today":N[k])+" "+f(s[0]);break}}
var el=document.querySelector("[data-status]");if(el){el.hidden=false;el.classList.add(open?"is-open":"is-closed");el.querySelector("[data-status-text]").textContent=t||"Closed"}
var td=document.querySelector("[data-today]");if(td&&row){td.textContent=row.querySelector("td").textContent}
})();
</script>
</body>
</html>
